{
  "name": "parse-scratchpad",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "db": "docker start parse-db || docker run --name parse-db -p 5432:5432 -e POSTGRES_PASSWORD=Passw0rd -d postgres",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "dashboard": "parse-dashboard --config parse-dashboard-config.json",
    "lint": "eslint --cache ./controllers && eslint --cache ./constants && eslint --cache index.js",
    "lint-fix": "eslint --cache --fix ./controllers && eslint --cache --fix ./constants && eslint --cache --fix index.js",
    "prettier": "prettier --write '{controllers,constants}/{**/*,*}.js' 'index.js'",
    "parse": "parse-server"
  },
  "dependencies": {
    "express": "^4.18.2",
    "graphql-tag": "^2.12.6",
    "parse-dashboard": "^5.1.0",
    "parse-server": "^6.2.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.21.3",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=16 <17 || >=18 <19"
  }
}
